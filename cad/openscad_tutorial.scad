// ============================================================
// openscad_tutorial.scad
//
// OpenSCAD を10ステップで覚える
// 題材は自分のV-Plotterの部品なので、最後には
// motor_mount.scad が読めるようになる。
//
// 使い方:
//   1. OpenSCADで開く
//   2. 下の STEP の数字を 1 から順に変える
//   3. F5 を押す(プレビュー) → 形を見る
//   4. 数値をいじって F5 → どう変わるか見る
//
//   F5 = 速いプレビュー(作業中はこれ)
//   F6 = 正確なレンダリング(STL出力前に1回)
//   F7 = STL書き出し
// ============================================================

STEP = 1;   // ★ここを 1〜10 に変えて F5

$fn = 48;   // 円の分割数。大きいほど滑らかで遅い。
            // 作業中は 24、出力前に 64〜96 が定石。

// ============================================================
// STEP 1: 基本立体は3つだけ
//   cube / cylinder / sphere
//   これと「足す・引く」だけで大半のものが作れる。
// ============================================================
module step1() {
    cube([30, 20, 10]);                    // [X, Y, Z]
    translate([50, 0, 0]) cube(15, center = true);  // 原点中心

    translate([0, 50, 0]) cylinder(d = 20, h = 25);
    translate([50, 50, 0]) cylinder(d1 = 20, d2 = 5, h = 25);  // 円錐

    translate([100, 25, 10]) sphere(d = 20);
}

// ============================================================
// STEP 2: 変形は「直後の1つ」にしかかからない
//   ここが最初の関門。
// ============================================================
module step2() {
    // 移動
    cube(10);
    translate([20, 0, 0]) cube(10);

    // 回転 [X軸まわり, Y軸まわり, Z軸まわり] 単位は度
    translate([40, 0, 0]) rotate([0, 0, 30]) cube(10);

    // 鏡像 --- 左右対称の部品はこれ1行で作れる
    translate([0, 40, 0]) {
        cube([20, 5, 5]);
        mirror([1, 0, 0]) cube([20, 5, 5]);   // X方向に反転
    }

    // ★複数にかけたいときは { } で囲む
    translate([0, 60, 0]) {
        cube(8);
        translate([12, 0, 0]) cube(8);
    }
}

// ============================================================
// STEP 3: difference() = 引き算  ← 一番よく使う
//   1つ目から、2つ目以降を全部引く。順番が命。
// ============================================================
module step3() {
    // ネジ穴の開いた板
    difference() {
        cube([40, 40, 6]);                          // ベース
        translate([10, 10, -1]) cylinder(d = 3.4, h = 8);  // M3バカ穴
        translate([30, 10, -1]) cylinder(d = 3.4, h = 8);
        translate([10, 30, -1]) cylinder(d = 3.4, h = 8);
        translate([30, 30, -1]) cylinder(d = 3.4, h = 8);
    }

    // ★コツ: 引く円柱は必ず上下に1mmはみ出させる (-1, h=8)
    //   ぴったりだと面が重なって、レンダリングでゴミが出る。
}

// ============================================================
// STEP 4: union() と intersection()
// ============================================================
module step4() {
    // union = 足し算。実は書かなくても勝手に足される。
    union() {
        cube([30, 10, 10]);
        translate([0, 0, 10]) cube([10, 10, 20]);
    }

    // intersection = 共通部分だけ残す
    // ★テストピースを切り出すのにすごく便利
    translate([50, 0, 0])
        intersection() {
            cylinder(d = 30, h = 30);
            cube([20, 20, 40], center = true);
        }
}

// ============================================================
// STEP 5: hull() = 包む   ← 角丸はこれで作る
//   OpenSCADはフィレットが苦手なので、最初から
//   「丸いものを包む」設計にするのが定石。
// ============================================================
module step5() {
    // 角丸プレート(motor_head で実際に使っている手法)
    hull() {
        for (x = [-1, 1], y = [-1, 1])
            translate([x * 20, y * 20, 0])
                cylinder(r = 5, h = 5);
    }
    // → 50x50 で角R5の板になる

    // 2つの円柱を包むと「長穴」形状
    translate([70, 0, 0])
        hull() {
            cylinder(d = 12, h = 5);
            translate([30, 0, 0]) cylinder(d = 12, h = 5);
        }
}

// ============================================================
// STEP 6: 2D → 3D    linear_extrude と rotate_extrude
//   複雑な断面はこれ。リブや三角ガセットに使う。
// ============================================================
module step6() {
    // 三角形のリブ(motor_mount のリブはこの方法)
    linear_extrude(4)
        polygon([[0, 0], [30, 0], [0, 25]]);

    // ねじり押し出し
    translate([50, 0, 0])
        linear_extrude(height = 30, twist = 90)
            square([15, 15], center = true);

    // 回転押し出し = 旋盤
    translate([100, 0, 0])
        rotate_extrude()
            translate([15, 0]) square([5, 20]);
}

// ============================================================
// STEP 7: 変数とモジュール
//   ここからが「パラメトリックCAD」の本領。
//   寸法を変数にしておくと、実測値が変わっても1行直すだけ。
// ============================================================

m3_d       = 3.4;    // M3バカ穴
nema_bolt  = 31.0;   // NEMA17のボルト間隔
plate_t    = 5;

module nema17_plate() {              // 部品を関数にまとめる
    difference() {
        hull() for (x = [-1,1], y = [-1,1])
            translate([x*21, y*21, 0]) cylinder(r = 5, h = plate_t);
        for (a = [0:90:270])
            rotate([0, 0, a])
                translate([nema_bolt/2, nema_bolt/2, -1])
                    cylinder(d = m3_d, h = plate_t + 2);
        translate([0, 0, -1]) cylinder(d = 23, h = plate_t + 2);
    }
}

module step7() {
    nema17_plate();
    translate([70, 0, 0]) nema17_plate();   // 何度でも使い回せる
}

// ============================================================
// STEP 8: for ループ と 引数つきモジュール
// ============================================================

module rib(len, height, thick = 4) {   // = 4 は既定値
    linear_extrude(thick)
        polygon([[0, 0], [len, 0], [0, height]]);
}

module step8() {
    // 4隅にボルト穴 --- rotate と for の組み合わせが定番
    difference() {
        cube([50, 50, 6], center = true);
        for (a = [0:90:270])
            rotate([0, 0, a])
                translate([18, 18, -5]) cylinder(d = 3.4, h = 12);
    }

    // 肉抜き穴を等間隔に
    translate([70, -25, 0])
        difference() {
            cube([30, 120, 6]);
            for (y = [15 : 25 : 110])
                translate([15, y, -1]) cylinder(d = 12, h = 8);
        }

    translate([0, 60, 0]) rib(30, 20);
    translate([40, 60, 0]) rib(30, 20, 8);
}

// ============================================================
// STEP 9: 実戦テクニック
// ============================================================
module step9() {

    // (a) ナット埋め込み座 --- $fn=6 で六角形になる
    difference() {
        cube([20, 20, 12], center = true);
        cylinder(d = 4.3, h = 30, center = true);
        translate([0, 0, 2])
            cylinder(d = 7.2 / cos(30), h = 4, $fn = 6);  // M4ナット
    }
    // ★ /cos(30) が重要。$fn=6 の d は外接円なので、
    //   二面幅(7.2mm)から外接円径に換算している。

    // (b) はめあいクリアランス
    //   3Dプリンタは膨らむので、穴は必ず +0.3〜0.5mm
    translate([40, 0, 0]) {
        difference() {
            cube([30, 30, 12], center = true);
            cube([20 + 0.4, 12 + 0.4, 30], center = true);  // ← +0.4
        }
    }

    // (c) テストピースの切り出し
    //   大物を刷る前に、はめあい部分だけ確認する
    translate([90, 0, 0])
        intersection() {
            nema17_plate();
            translate([-30, -30, -1]) cube([60, 30, 20]);
        }
}

// ============================================================
// STEP 10: 総合 --- 継手を作ってみる
//   motor_mount.scad の中身とほぼ同じ。
//   ここまで読めれば、あのファイルは全部理解できる。
// ============================================================

JW = 26; JD = 12; JL = 24;    // 凸部の 幅 / 奥行 / 長さ
JWALL = 4;                    // ソケットの肉厚
JCL = 0.35;                   // はめあいすきま
JOX = JW + JWALL*2;           // ソケット外形X = 34
JOY = JD + JWALL*2;           // 同 Y = 20

module joint_bolts() {
    for (z = [7, 18])
        translate([-JOX/2 - 1, 0, z])
            rotate([0, 90, 0]) cylinder(d = 4.3, h = JOX + 2);
}

module tongue() {             // 凸
    difference() {
        translate([-JW/2, -JD/2, 0]) cube([JW, JD, JL]);
        joint_bolts();
    }
}

module socket() {             // 凹
    difference() {
        translate([-JOX/2, -JOY/2, 0]) cube([JOX, JOY, JL]);
        translate([-(JW+JCL)/2, -(JD+JCL)/2, -1])
            cube([JW+JCL, JD+JCL, JL + 1.5]);
        joint_bolts();
    }
}

module step10() {
    tongue();
    translate([60, 0, 0]) socket();

    // 組んだ状態を確認する(# を付けるとハイライト表示)
    translate([130, 0, 0]) {
        socket();
        # tongue();      // ← # でデバッグ表示。%(透明) ! (単独表示) も便利
    }
}

// ============================================================
// 実行
// ============================================================

if (STEP == 1)  step1();
if (STEP == 2)  step2();
if (STEP == 3)  step3();
if (STEP == 4)  step4();
if (STEP == 5)  step5();
if (STEP == 6)  step6();
if (STEP == 7)  step7();
if (STEP == 8)  step8();
if (STEP == 9)  step9();
if (STEP == 10) step10();


// ============================================================
// 覚えておくと効くこと
// ============================================================
//
// ■ デバッグ記号(モジュールの前に付ける)
//     #  ハイライト表示 --- 引く前の形を確認するのに便利
//     %  透明表示 --- 干渉チェックに便利
//     !  それだけ表示 --- 一部分だけ確認
//     *  無効化 --- コメントアウトの代わり
//
// ■ 3Dプリント前提の設計ルール
//     穴は +0.3〜0.5mm    (プリンタは膨らむ)
//     引く立体は 1mm はみ出させる (面の重なりを避ける)
//     45度を超えるオーバーハングは避ける (サポート不要にする)
//     ネジ穴は積層方向と垂直に (層間剥離を避ける)
//
// ■ 作業のリズム
//     F5 で確認しながら作る → 最後に F6 → F7 でSTL
//     $fn は作業中 24、出力前 64〜96
//
// ■ 他のCADとの使い分け
//     OpenSCAD : 寸法がはっきりした機械部品、パラメトリック
//     Fusion360: 曲面、アセンブリ、図面、フィレット多用
//     FreeCAD  : 無料でFusion的なことをやりたいとき
//     どれか1つでなく、用途で使い分けるのが普通。

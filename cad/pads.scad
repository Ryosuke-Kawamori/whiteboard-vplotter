// ============================================================
// pads.scad
// 枠クランプ用 保護パッド
//   ホワイトボード枠の塗装を守り、同時に滑り止めにもなる。
//
// 材質: TPU(95A) が理想。なければ PLA/PETG で刷って
//       接触面にゴムシートや自己融着テープを貼る。
//
// 印刷: 0.2mm / 壁3本 / インフィル40%(TPUなら20%)
//       TPUは速度30mm/s以下、リトラクト最小に
// ============================================================

jaw_t     = 6.0;    // ジョーの肉厚(motor_mount.scad と揃える)
clamp_w   = 50.0;   // クランプ幅
m4_shank  = 3.5;    // M4ネジ山に食い込ませる下穴(TPU用)
                    // PLAで刷るなら 4.1 にして接着

$fn = 48;

// ============================================================
// 1. ボルト先端パッド
//    M4ボルトの先端に押し込むキャップ。これで枠の裏を押す。
//    ネジ山に食い込んで抜けない。★2個必要(左右で計4個)
// ============================================================

module bolt_pad() {
    difference() {
        union() {
            // 本体
            cylinder(d = 9, h = 7);
            // 接触面(少しドーム状にして片当たりを防ぐ)
            translate([0, 0, 7]) cylinder(d1 = 9, d2 = 8, h = 1.2);
        }
        // ボルトが刺さる穴
        translate([0, 0, -0.1]) cylinder(d = m4_shank, h = 5.6);
        // 差し込み口の面取り
        translate([0, 0, -0.1]) cylinder(d1 = 4.6, d2 = m4_shank, h = 1.4);
    }
}

// ============================================================
// 2. ジョー用クリップパッド
//    表側ジョーの内面にパチンとはめる U字クリップ。
//    接着不要。盤面側の塗装を守り、摩擦も稼げる。
//    ★2個必要(左右で計2〜4個)
// ============================================================

pad_face = 1.6;     // 接触面の厚み
pad_len  = 46;      // 長さ(clamp_w より少し短く)
pad_h    = 26;      // 高さ

module jaw_pad() {
    grip = 5;       // 折り返してジョーを掴む長さ

    difference() {
        union() {
            // 接触面
            cube([pad_len, pad_face, pad_h]);
            // 上端の折り返し(ジョー上端に引っ掛ける)
            translate([0, 0, pad_h])
                cube([pad_len, pad_face + jaw_t + pad_face, 2.4]);
            translate([0, pad_face + jaw_t, pad_h - grip])
                cube([pad_len, pad_face, grip + 2.4]);
        }
        // 滑り止めの溝(接触面側)
        for (z = [5 : 5 : pad_h - 4])
            translate([-1, -0.1, z]) cube([pad_len + 2, 0.7, 1.4]);
    }
}

// ============================================================
// 3. 貼り付け式パッド (TPUがない場合の簡易版)
//    PLA/PETGで刷って両面テープで貼る。
//    または、このサイズにゴムシートを切って使う型紙代わり。
// ============================================================

module flat_pad() {
    difference() {
        cube([pad_len, pad_h, 1.8]);
        for (y = [4 : 5 : pad_h - 3])
            translate([-1, y, 1.1]) cube([pad_len + 2, 1.4, 0.8]);
    }
}

// ============================================================
// 出力
// ============================================================

// ボルト先端パッド x4
for (i = [0:3])
    translate([i * 14, 0, 0]) bolt_pad();

// ジョー用クリップパッド x2
translate([0, 30, 0]) jaw_pad();
translate([0, 60, 0]) jaw_pad();

// 貼り付け式(必要なら)
// translate([0, 100, 0]) flat_pad();

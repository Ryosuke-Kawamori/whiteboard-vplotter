// ============================================================
// bushing.scad
// ゴンドラのマーカー穴を細くするアダプターブッシュ
//
// ゴンドラ本体を刷り直さずに、内径だけ変えられる。
// マーカーを変えたら、このブッシュだけ刷り直せばよい。
//
// 印刷: PLA / 壁3本 / インフィル30% / サポート不要 / 立てて印刷
//       10分・数グラムで終わる
// ============================================================

// ---------- ゴンドラ側(gondola.scad と揃える) ----------
sleeve_bore = 20.5;   // ゴンドラのマーカー穴の実寸(= marker_d_big + 0.5)
clamp_slot  = 2.6;    // ゴンドラの締め付けスリット幅
bore_depth  = 38;     // プレート厚 + スリーブ高さ (4 + 34)

// ---------- 入れたいマーカーの径 ----------
marker_d    = 15.4;   // ★実測値 + 0.4  ここだけ変えればよい

// ---------- 調整 ----------
fit         = 0.3;    // ゴンドラ穴とのすきま
flange_d    = 27;     // 抜け落ち防止のツバ
flange_t    = 2.5;
split_w     = 2.8;    // 割りスリットの幅(締め付けを効かせる)

$fn = 96;

// ============================================================

module bushing() {
    od = sleeve_bore - fit;

    difference() {
        union() {
            // 筒
            cylinder(d = od, h = bore_depth);
            // ツバ(上端)
            translate([0, 0, bore_depth])
                cylinder(d = flange_d, h = flange_t);
            // 位置決めキー
            //   ゴンドラのスリットにはまり、割りの向きが自動で合う。
            //   これがないと締め付けネジが効かない。
            translate([-od/2 - 1.6, -(clamp_slot - 0.4)/2, 0])
                cube([2.4, clamp_slot - 0.4, bore_depth]);
        }
        // マーカーが入る穴
        translate([0, 0, -1]) cylinder(d = marker_d, h = bore_depth + flange_t + 2);
        // 入り口の面取り(マーカーを挿しやすく)
        translate([0, 0, bore_depth + flange_t - 1.8])
            cylinder(d1 = marker_d, d2 = marker_d + 3.4, h = 2);
        // 割りスリット(キーと同じ向き = -X)
        translate([-od/2 - 4, -split_w/2, -1])
            cube([od/2 + 4, split_w, bore_depth + flange_t + 2]);
        // 締め付けネジの逃げ(ゴンドラのM3が通る位置)
        for (z = [9 + 4, 34 - 9 + 4])
            translate([0, -20, z]) rotate([-90, 0, 0])
                cylinder(d = 4.0, h = 40);
    }
}

// ============================================================
// テストリング(先にこれだけ刷って径を確認する・3分)
// ============================================================

module test_ring() {
    intersection() {
        bushing();
        translate([0, 0, 4]) cylinder(d = 40, h = 12);
    }
}

// ============================================================

bushing();

